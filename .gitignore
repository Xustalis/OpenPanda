# Go
# Compiled binaries. Anchored to repo root so they don't also match the
# cmd/panda/ source directory (a bare "panda" pattern would ignore that too).
/panda
/panda-*
*.exe
*.test
*.out
dist/
bin/
# Ad-hoc smoke binaries built to verify a dependency resolves (e.g. the
# Bubble Tea import probe). Always regenerated, never committed.
/_teasmoke

# Editor debug-session binaries (dlv/gopls __debug_bin* under cmd/).
__debug_bin*

# SQLite
*.db
*.db-wal
*.db-shm

# Config (contains local node credentials / peers)
config.yaml
capabilities.yaml

# Secret material — never committed regardless of where it lands. Force-add
# (-f) only for deliberate, non-secret fixtures.
.env
.env.*
!.env.example
*.pem
*.key
release-key

# Local lab/test node dirs — scratch configs and their SQLite state live
# here; the generic config.yaml/data/ rules cover most of it, but the dir
# itself must never become a commit candidate.
/.lab-echo/
/.lab-*/

# Runtime data
data/
var/
context/
*.sock
testdata/run/
# Loopback test-node state (node-a.yaml / node-b.yaml fixtures)
testdata/node-a/
testdata/node-b/
testdata/node-c/
testdata/sessions/
testdata/daemon.pid
testdata/artifacts/

# Live personal data (real memory/diary/skills captured from this machine —
# test fixtures for local runs only, never for the repo)
testdata/live/

# Hermes personal memory (Dreaming runtime output)
/memory/
/projects/
/skills/

# Daemon runtime dirs created directly under work_path — with work_path="."
# (the loopback/dev config) these land at the repo root: stage workdirs, task
# workspaces, adopted project copies. Runtime output, never source. (New
# builds hide them under .openpanda/ — already ignored above.)
/plans/
/tasks/
/tmp/

# Dev-layout daemon state at the repo root: a config with db_path="./node.db"
# drops its pid file and SQLite sidecars next to the checkout.
/daemon.pid
/node.db*

# Workspace memory layers the daemon writes when its workspace is the repo
MEMORY.md
USER.md

# Node (webui/web frontend tooling)
node_modules/

# Embedded web console build output: only the placeholder is committed so
# `go build` works without node; `make web` materializes the real app.
!webui/panel/dist/
webui/panel/dist/*
!webui/panel/dist/index.html

# Python
__pycache__/
*.pyc
.venv/
venv/
.installer-go-cache/
.installer-go-modcache/
.installer-test-dist/
# In-workspace Go build cache (used where the sandbox forbids /tmp)
.gocache-tmp/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Logs
*.log
logs/

# Internal design & planning docs stay local-only under author/.
# The rest of docs/ is versioned normally (index, user guides, protocol).
/PANDA-*.md
# Author's design notes and reports: local working material, never versioned.
# Kept out of the tracked tree so a `git add -A` never sweeps them in.
/author/

# Local personal configs and per-device capability cards:
# keep them on disk so `panda` keeps working, but never push them upstream.
/config.local.yaml
/config/capabilities.*.yaml
!/config/capabilities.example-*.yaml

# TRAE assistant workspace
.trae/

# Local / personal tooling (unrelated to PANDA core)
.workbuddy/

# Git worktrees managed by external tools (e.g. openpanda worktree helper)
.openpanda/

# Local scratch: analysis notes and agent scratchpads that get regenerated every
# session. They were previously neither tracked nor ignored, so `git add -A`
# would have committed them — including .lab-real/, a live multi-node lab
# directory that holds a real shared secret.
/findings.md
/progress.md
/task_plan.md
# Local review / handoff notes: same class as findings.md, regenerated per
# session, never pushed.
/审查报告_*.md
/ClaudeCode任务交接_*.md
/.lab-real/
/.planning/
check_emails.py
fetch_emails.py
.claude/settings.local.json

# Early design prototypes (superseded by webui/)
/openpanda-console-design/

# One-off review / analysis notes under docs/
/docs/uncommitted-review-*.md

# Lab scratch directories
/.lab/

# Local design references and visual-companion drafts
/.superpowers/

.gocache-tmp
/.gocache/

/assets


# Updater bookkeeping manifests written into resource dirs when an update is
# applied in-place (adapters/, extensions/voice/) — regenerated per update.
.adapters.manifest
.voice.manifest

# Agent-assistant workspace data (session notes, scratch reports). Written by
# an external tool into whatever directory it was pointed at, so it lands in the
# checkout whenever the repo *is* that directory. Never source.
/.workbuddy-ai/
/.workbuddy/

# Local scratch runs: probe configs, daemon output, screenshots taken while
# verifying the console. Regenerated every session, and large enough that a
# stray `git add -A` would have pushed megabytes of PNGs.
/.ztest/
/.ztest_*.js

# Daemon session files written to the repo root when work_path="." — the
# per-conversation state of a local dev node, not a fixture.
/sessions/

# Editor/codemod leftovers that shadow a real source file.
*.bak

# Throwaway probe tests written while investigating a finding (zz_*_test.go).
# They are scratch, not fixtures: a real regression test gets a descriptive
# name and is committed deliberately.
zz_*_test.go

# Internal design, roadmap, test and report documents live under author/docs/
# and are not part of the public source tree. These three entries are a
# backstop: a draft that lands in docs/ by mistake stays local instead of
# being swept into the tracked tree by the next `git add -A`.
/docs/plans/
/docs/reports/
/docs/testing/
