# Go
# Compiled binaries. Anchored to repo root so they don't also match the
# cmd/panda/ source directory (a bare "panda" pattern would ignore that too).
/panda
/panda-*
!PANDA-*.md
*.exe
*.test
*.out
dist/
bin/

# SQLite
*.db
*.db-wal
*.db-shm

# Config (contains local node credentials / peers)
config.yaml
capabilities.yaml

# Runtime data
data/
var/
context/
*.sock
testdata/run/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Logs
*.log
logs/
