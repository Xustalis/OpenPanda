# Go
# Compiled binaries. Anchored to repo root so they don't also match the
# cmd/panda/ source directory (a bare "panda" pattern would ignore that too).
/panda
/panda-*
*.exe
*.test
*.out
dist/
bin/
# Ad-hoc smoke binaries built to verify a dependency resolves (e.g. the
# Bubble Tea import probe). Always regenerated, never committed.
/_teasmoke

# SQLite
*.db
*.db-wal
*.db-shm

# Config (contains local node credentials / peers)
config.yaml
capabilities.yaml

# Runtime data
data/
var/
context/
*.sock
testdata/run/

# Live personal data (real memory/diary/skills captured from this machine —
# test fixtures for local runs only, never for the repo)
testdata/live/

# Hermes personal memory (Dreaming runtime output)
/memory/
/projects/
/skills/

# Node (webui/web frontend tooling)
node_modules/

# Embedded web console build output: only the placeholder is committed so
# `go build` works without node; `make web` materializes the real app.
!webui/panel/dist/
webui/panel/dist/*
!webui/panel/dist/index.html

# Python
__pycache__/
*.pyc
.venv/
venv/
.installer-go-cache/
.installer-go-modcache/
.installer-test-dist/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Logs
*.log
logs/

# Internal design & planning docs stay local-only under docs/author/.
# The rest of docs/ is versioned normally (index, roadmap, user guides...).
/PANDA-*.md
/docs/author/

# Local personal configs and per-device capability cards:
# keep them on disk so `panda` keeps working, but never push them upstream.
/config.local.yaml
/config/capabilities.*.yaml
!/config/capabilities.example-*.yaml

# TRAE assistant workspace
.trae/

# Local / personal tooling (unrelated to PANDA core)
.workbuddy/

# Git worktrees managed by external tools (e.g. openpanda worktree helper)
.openpanda/

# Local scratch: analysis notes and agent scratchpads that get regenerated every
# session. They were previously neither tracked nor ignored, so `git add -A`
# would have committed them — including .lab-real/, a live multi-node lab
# directory that holds a real shared secret.
/findings.md
/progress.md
/task_plan.md
# Local review / handoff notes: same class as findings.md, regenerated per
# session, never pushed.
/审查报告_*.md
/ClaudeCode任务交接_*.md
/.lab-real/
/.planning/
check_emails.py
fetch_emails.py
.claude/settings.local.json
