# Go
# Compiled binaries. Anchored to repo root so they don't also match the
# cmd/panda/ source directory (a bare "panda" pattern would ignore that too).
/panda
/panda-*
*.exe
*.test
*.out
dist/
bin/

# SQLite
*.db
*.db-wal
*.db-shm

# Config (contains local node credentials / peers)
config.yaml
capabilities.yaml

# Runtime data
data/
var/
context/
*.sock
testdata/run/

# Hermes personal memory (Dreaming runtime output)
/memory/
/projects/
/skills/

# Node (webui/web frontend tooling)
node_modules/

# Embedded web console build output: only the placeholder is committed so
# `go build` works without node; `make web` materializes the real app.
!webui/panel/dist/
webui/panel/dist/*
!webui/panel/dist/index.html

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Logs
*.log
logs/

# Internal design & planning docs (kept out of the public repo).
# Root design/plan docs and most docs/ content carry private info (devices,
# IPs, local paths, usernames) and personal notes. Public docs are whitelisted
# file by file: the index, the system audit report, and the public roadmap.
/PANDA-*.md
/docs/*
!/docs/README.md
!/docs/reports/
/docs/reports/*
!/docs/reports/system-audit-2026-08-18.md
!/docs/plans/
/docs/plans/*
!/docs/plans/roadmap-desktop-and-packaging.md

# TRAE assistant workspace
.trae/

# Local / personal tooling (unrelated to PANDA core)
.workbuddy/
check_emails.py
fetch_emails.py
.claude/settings.local.json
