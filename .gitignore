# Go
# Compiled binaries. Anchored to repo root so they don't also match the
# cmd/panda/ source directory (a bare "panda" pattern would ignore that too).
/panda
/panda-*
*.exe
*.test
*.out
dist/
bin/

# SQLite
*.db
*.db-wal
*.db-shm

# Config (contains local node credentials / peers)
config.yaml
capabilities.yaml

# Runtime data
data/
var/
context/
*.sock
testdata/run/

# Hermes personal memory (Dreaming runtime output)
/memory/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Logs
*.log
logs/

# Internal design & planning docs (kept out of the public repo).
# Root design/plan docs and everything under docs/ except the index carry
# private info (devices, IPs, local paths, usernames) and personal notes, so
# only docs/README.md ships.
/PANDA-*.md
/docs/*
!/docs/README.md

# Local / personal tooling (unrelated to PANDA core)
.workbuddy/
check_emails.py
fetch_emails.py
.claude/settings.local.json
