<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OpenPanda macOS node — LaunchAgent, runs the kernel daemon headless in the
  background: no terminal window, starts at login, restarts on crash.

  Install (adjust the binary path / WorkingDirectory / PATH below to your
  checkout or install prefix first):
    cp deploy/macos/com.openpanda.node.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.openpanda.node.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.openpanda.node.plist

  The EnvironmentVariables/PATH entry is not optional. launchd hands a job
  PATH=/usr/bin:/bin:/usr/sbin:/sbin, so without it every agent CLI
  (~/.local/bin/claude, /opt/homebrew/bin/codex, ...) and every runtime a
  capability card declares (node, python3) resolves as "command not found"
  inside the daemon: the card prunes abilities the host really has and the
  router falls back down its agent chain for no visible reason. A node started
  by hand from a terminal works and the same node started at login does not —
  this dict is the difference. Replace /Users/you with your own home directory;
  the list mirrors internal/carddetect's fallbackBinDirs, so keep the two in
  step.

  No --config/--card flags: the daemon auto-discovers them the same way an
  interactive `panda daemon` does — OPENPANDA_CONFIG_PATH →
  ~/Library/Application Support/openpanda/config.yaml (where `panda init`
  writes) → /etc/openpanda/config.yaml; the capability card is looked up in
  the working directory and next to the resolved config. To pin a specific
  config, add an EnvironmentVariables dict with OPENPANDA_CONFIG_PATH.

  Logs: /tmp/openpanda-daemon.out.log (JSON) and /tmp/openpanda-daemon.err.log.
-->
<plist version="1.0">
<dict>
        <key>Label</key>
        <string>com.openpanda.node</string>
        <key>ProgramArguments</key>
        <array>
                <string>/usr/local/openpanda/bin/panda</string>
                <string>daemon</string>
        </array>
        <key>WorkingDirectory</key>
        <string>/usr/local/openpanda</string>
        <key>EnvironmentVariables</key>
        <dict>
                <key>PATH</key>
                <string>/Users/you/.local/bin:/Users/you/.cargo/bin:/Users/you/.grok/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        </dict>
        <key>RunAtLoad</key>
        <true/>
        <key>KeepAlive</key>
        <true/>
        <key>ProcessType</key>
        <string>Background</string>
        <key>StandardOutPath</key>
        <string>/tmp/openpanda-daemon.out.log</string>
        <key>StandardErrorPath</key>
        <string>/tmp/openpanda-daemon.err.log</string>
</dict>
</plist>
